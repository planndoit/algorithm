# Server only: never prefix these with NEXT_PUBLIC_
DATABASE_URL=
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
RATE_LIMIT_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Local UI sample only. Set false for a real service.
DEMO_MODE=false

# Daily Vercel Cron authentication (random secret, server only)
CRON_SECRET=
# Optional: Google Cloud YouTube Data API v3, restricted to this API
YOUTUBE_API_KEY=
# Instagram hashtag discovery requires Facebook Login + Public Content Access.
# Store a long-lived User access token as a production-only Secret.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
# Optional pinned Graph API version (default v26.0)
META_GRAPH_API_VERSION=v26.0

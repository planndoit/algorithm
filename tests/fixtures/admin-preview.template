import "../admin/admin.css";
export const dynamic = "force-dynamic";
export default async function Page({
  searchParams,
}: {
  searchParams: Promise<{ screen?: string }>;
}) {
  if (
    process.env.NODE_ENV !== "development" ||
    process.env.ADMIN_UI_QA !== "true"
